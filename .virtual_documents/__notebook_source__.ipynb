    ]
].copy()



# Convert date

ts_data["date"] = pd.to_datetime(
    ts_data["date"]
)



# Aggregate duplicate dates
# Sum cases from all records

ts_data = (
    ts_data
    .groupby("date")
    ["dengue_cases"]
    .sum()
    .reset_index()
)



# Sort dates

ts_data = ts_data.sort_values(
    "date"
)



# Set date index

ts_data = ts_data.set_index(
    "date"
)



# Create daily frequency

ts_data = ts_data.asfreq(
    "D"
)



