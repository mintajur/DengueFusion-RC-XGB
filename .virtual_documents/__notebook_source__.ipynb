# ==================================
# Cell 14:
# Evaluation Function
# ==================================

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

import numpy as np


results = []


def evaluate_model(model_name, y_true, y_pred, dataset_type):

    mae = mean_absolute_error(
        y_true,
        y_pred
    )


    rmse = np.sqrt(
        mean_squared_error(
            y_true,
            y_pred
        )
    )


    mape = np.mean(
        np.abs(
            (y_true - y_pred)
            /
            (y_true + 1)
        )
    ) * 100



    r2 = r2_score(
        y_true,
        y_pred
    )



    results.append(
        {
            "Model": model_name,
            "Dataset": dataset_type,
            "MAE": mae,
            "RMSE": rmse,
            "MAPE": mape,
            "R2": r2
        }
    )


    print("\n", model_name, "-", dataset_type)

    print("------------------------------")

    print("MAE :", round(mae,3))
    print("RMSE:", round(rmse,3))
    print("MAPE:", round(mape,3))
    print("R2  :", round(r2,3))


