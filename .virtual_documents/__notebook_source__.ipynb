# ==================================
# Cell 148:
# Correct Rolling Temporal Validation
# ==================================

import numpy as np
import pandas as pd

from xgboost import XGBRegressor

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)


# Combine train + validation only

X_temporal = pd.concat(
    [
        X_train_fe,
        X_val_fe
    ],
    axis=0
).reset_index(drop=True)



y_temporal = pd.concat(
    [
        pd.Series(y_train_fe),
        pd.Series(y_val_fe)
    ],
    axis=0
).reset_index(drop=True)



results_temporal = []


n = len(X_temporal)


# Five expanding windows

fold_settings = [

    (0.60, 0.70),

    (0.65, 0.75),

    (0.70, 0.80),

    (0.75, 0.85),

    (0.80, 0.90)

]



for fold, (train_ratio, val_ratio) in enumerate(
    
    fold_settings,

    start=1

):


    train_end = int(n * train_ratio)

    val_end = int(n * val_ratio)



    X_train_fold = X_temporal.iloc[
        :train_end
    ]


    y_train_fold = y_temporal.iloc[
        :train_end
    ]



    X_val_fold = X_temporal.iloc[
        train_end:val_end
    ]


    y_val_fold = y_temporal.iloc[
        train_end:val_end
    ]



    print(
        f"Fold {fold}: Train={len(X_train_fold)}, Validation={len(X_val_fold)}"
    )



    model = XGBRegressor(

        n_estimators=400,

        learning_rate=0.03,

        max_depth=5,

        subsample=0.8,

        colsample_bytree=0.8,

        reg_lambda=5,

        objective="reg:squarederror",

        random_state=42

    )



    model.fit(

        X_train_fold,

        np.log1p(y_train_fold)

    )



    pred_log = model.predict(

        X_val_fold

    )


    pred = np.expm1(

        pred_log

    )


    pred = np.maximum(

        pred,

        0

    )



    mae = mean_absolute_error(

        y_val_fold,

        pred

    )


    rmse = np.sqrt(

        mean_squared_error(

            y_val_fold,

            pred

        )

    )


    r2 = r2_score(

        y_val_fold,

        pred

    )



    results_temporal.append({

        "Fold": fold,

        "MAE": mae,

        "RMSE": rmse,

        "R2": r2

    })



temporal_results = pd.DataFrame(

    results_temporal

)



temporal_results


