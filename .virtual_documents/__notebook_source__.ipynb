# ==================================
# Peak Matching Analysis
# ==================================

import numpy as np


matched_results = []


for _, actual in actual_peaks.iterrows():

    actual_date = actual["date"]


    # Calculate distance from all predicted peaks

    if len(predicted_peaks) > 0:

        differences = (

            abs(

                predicted_peaks["date"]

                -

                actual_date

            )

        )


        closest_idx = differences.idxmin()


        closest_pred = predicted_peaks.loc[closest_idx]


        delay = (

            closest_pred["date"]

            -

            actual_date

        ).days



        matched_results.append({

            "Actual_Date":

                actual_date,


            "Actual_Cases":

                actual["actual_cases"],


            "Predicted_Date":

                closest_pred["date"],


            "Predicted_Cases":

                closest_pred["predicted_cases"],


            "Delay_days":

                delay,


            "Magnitude_Error":

                abs(

                    actual["actual_cases"]

                    -

                    closest_pred["predicted_cases"]

                )

        })



peak_comparison = pd.DataFrame(

    matched_results

)


peak_comparison


peak_summary = {

"Mean Absolute Delay":

    peak_comparison["Delay_days"].abs().mean(),


"Peaks within 7 days":

    (
      peak_comparison["Delay_days"].abs() <= 7
    ).mean()*100,


