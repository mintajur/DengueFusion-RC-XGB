# ==================================
# Cell 54:
# Advanced Dengue Feature Engineering
# ==================================


df_fe = df.copy()



# Ensure sorted by date

df_fe = df_fe.sort_values(
    "date"
)



# -------------------------------
# Additional Lag Features
# -------------------------------


for lag in [3,5,21,60]:

    df_fe[f"cases_lag_{lag}"] = (

        df_fe["dengue_cases"]
        .shift(lag)

    )



# -------------------------------
# Growth Rate Features
# -------------------------------


df_fe["growth_7"] = (

    df_fe["dengue_cases"]

    -
    df_fe["dengue_cases"].shift(7)

) / (

    df_fe["dengue_cases"].shift(7)
    + 1

)



df_fe["growth_14"] = (

    df_fe["dengue_cases"]

    -
    df_fe["dengue_cases"].shift(14)

) / (

    df_fe["dengue_cases"].shift(14)
    + 1

)



df_fe["growth_30"] = (

    df_fe["dengue_cases"]

    -
    df_fe["dengue_cases"].shift(30)

) / (

    df_fe["dengue_cases"].shift(30)
    + 1

)



# -------------------------------
# Climate Interaction Features
# -------------------------------


df_fe["humidity_rainfall"] = (

    df_fe["humidity"]

    *
    df_fe["rainfall_mm"]

)



df_fe["temperature_rainfall"] = (

    df_fe["temperature"]

    *
    df_fe["rainfall_mm"]

)



# Remove missing rows created by lag

df_fe = df_fe.dropna()



print(
    "New Shape:"
)

