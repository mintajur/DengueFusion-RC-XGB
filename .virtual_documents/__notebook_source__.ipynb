# ==================================
# Cell 104:
# Walk Forward CatBoost-XGB Fusion
# ==================================

from sklearn.metrics import (
    r2_score,
    mean_absolute_error,
    mean_squared_error
)

import numpy as np



fold_results = []



fold = 1



for train_idx, val_idx in tscv.split(X_clean):


    print(
        "\n===================="
    )

    print(
        "Fold:",
        fold
    )


    X_train_fold = X_clean.iloc[
        train_idx
    ]


    X_val_fold = X_clean.iloc[
        val_idx
    ]



    y_train_fold = y_clean.iloc[
        train_idx
    ]


    y_val_fold = y_clean.iloc[
        val_idx
    ]



    # log transformation

    y_train_fold_log = np.log1p(
        y_train_fold
    )



    # CatBoost

    cat_fold = CatBoostRegressor(

        iterations=1000,

        learning_rate=0.03,

        depth=6,

        loss_function="RMSE",

        random_seed=42,

        verbose=0

    )


    cat_fold.fit(

        X_train_fold,

        y_train_fold_log

    )



    # XGBoost

    xgb_fold = XGBRegressor(

        n_estimators=700,

        learning_rate=0.03,

        max_depth=5,

        min_child_weight=3,

        subsample=0.9,

        colsample_bytree=0.9,

        objective="reg:squarederror",

        random_state=42,

        n_jobs=-1

    )



    xgb_fold.fit(

        X_train_fold,

        y_train_fold_log

    )



    # Predictions

    cat_pred = np.expm1(

        cat_fold.predict(

            X_val_fold

        )

    )


    xgb_pred = np.expm1(

        xgb_fold.predict(

            X_val_fold

        )

    )



    # Fusion

    final_pred = (

        0.85 * cat_pred

        +

        0.15 * xgb_pred

    )



    mae = mean_absolute_error(

        y_val_fold,

        final_pred

    )


    rmse = np.sqrt(

        mean_squared_error(

            y_val_fold,

            final_pred

        )

    )


    r2 = r2_score(

        y_val_fold,

        final_pred

    )



    fold_results.append(

        [

            fold,

            mae,

            rmse,

            r2

        ]

    )



    print(
        "MAE:",
        mae
    )

    print(
        "RMSE:",
        rmse
    )

    print(
        "R2:",
        r2
    )



    fold += 1


