# Cell 165:
# Bootstrap Prediction Intervals
# ==================================

import numpy as np
import pandas as pd

from xgboost import XGBRegressor


# Number of bootstrap models

n_bootstrap = 100


bootstrap_predictions = []



X_train_boot = X_train_fe.copy()

y_train_boot = y_train_fe.copy()



for i in range(n_bootstrap):


    # Random bootstrap sampling

    sample_indices = np.random.choice(

        len(X_train_boot),

        size=len(X_train_boot),

        replace=True

    )


    X_sample = X_train_boot.iloc[

        sample_indices

    ]


    y_sample = y_train_boot.iloc[

        sample_indices

    ]



    model_boot = XGBRegressor(

        n_estimators=400,

        learning_rate=0.03,

        max_depth=5,

        subsample=0.8,

        colsample_bytree=0.8,

        reg_lambda=5,

        random_state=i

    )



    # Log transformation

    model_boot.fit(

        X_sample,

        np.log1p(y_sample)

    )



    pred_log = model_boot.predict(

        X_test_fe

    )


    pred = np.expm1(

        pred_log

    )


    pred = np.maximum(

        pred,

        0

    )


    bootstrap_predictions.append(

        pred

    )



bootstrap_predictions = np.array(

    bootstrap_predictions

)



print(

    bootstrap_predictions.shape

)


# ==================================
# Cell 166:
# Prediction Interval Calculation
# ==================================

uncertainty_df = pd.DataFrame({

    "date":

        test_dates,


    "actual_cases":

        y_test_fe.values,


    "prediction":

        np.mean(

            bootstrap_predictions,

            axis=0

        ),


    "lower_bound":

        np.percentile(

            bootstrap_predictions,

            2.5,

            axis=0

        ),


    "upper_bound":

        np.percentile(

            bootstrap_predictions,

            97.5,

            axis=0

        )

})



