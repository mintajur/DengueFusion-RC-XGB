# Cell 21:
# Create Time-Series Sequences
# ==================================

import numpy as np


# Combine train, validation, test
# because sequence creation needs continuous time order

X_all = pd.concat(
    [
        X_train,
        X_val,
        X_test
    ]
)


y_all = pd.concat(
    [
        y_train,
        y_val,
        y_test
    ]
)



# Scale complete feature data
# (using already fitted scaler)

X_all_scaled = scaler.transform(
    X_all
)



def create_sequences(
    X,
    y,
    time_steps=30
):

    Xs = []
    ys = []


    for i in range(
        len(X)-time_steps
    ):

        Xs.append(
            X[i:i+time_steps]
        )


        ys.append(
            y.iloc[i+time_steps]
        )


    return np.array(Xs), np.array(ys)



TIME_STEPS = 30



X_seq, y_seq = create_sequences(
    X_all_scaled,
    y_all,
    TIME_STEPS
)



print(
    "Sequence Shape:"
)

print(
    X_seq.shape
)


print(
    y_seq.shape
)


