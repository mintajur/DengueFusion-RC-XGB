# Cell 171:
# Severity-Aware Calibration
# ==================================

import numpy as np
import pandas as pd


# Validation prediction errors

val_uncertainty_df = pd.DataFrame({

    "actual_cases": y_val_fe.values,

    "prediction": val_pred_final

})


val_uncertainty_df["absolute_error"] = abs(

    val_uncertainty_df["actual_cases"]

    -

    val_uncertainty_df["prediction"]

)



# Severity classification

def severity_class(cases):

    if cases <= 50:

        return "Low"

    elif cases <= 200:

        return "Moderate"

    else:

        return "High"



val_uncertainty_df["severity"] = (

    val_uncertainty_df["actual_cases"]

    .apply(severity_class)

)



val_uncertainty_df.head()


# ==================================
# Cell 172:
# Severity Calibration Errors
# ==================================

severity_quantiles = {}


for level in [

    "Low",

    "Moderate",

    "High"

]:

    errors = val_uncertainty_df[

        val_uncertainty_df["severity"] == level

    ]["absolute_error"]


    severity_quantiles[level] = np.quantile(

        errors,

        0.95

    )



severity_quantiles


# ==================================
# Cell 173:
# Adaptive Conformal Intervals
# ==================================

adaptive_df = pd.DataFrame({

    "date": test_dates,

    "actual_cases": y_test_fe.values,

    "prediction": final_test_pred

})


# Assign severity based on prediction

adaptive_df["severity"] = (

    adaptive_df["prediction"]

    .apply(severity_class)

)



adaptive_df["error_margin"] = (

    adaptive_df["severity"]

    .map(severity_quantiles)

)



adaptive_df["lower_bound"] = (

    adaptive_df["prediction"]

    -

    adaptive_df["error_margin"]

).clip(lower=0)



adaptive_df["upper_bound"] = (

    adaptive_df["prediction"]

    +

    adaptive_df["error_margin"]

)



adaptive_df.head()


# ==================================
# Cell 174:
# Adaptive Coverage
# ==================================

coverage = (

    (

    (adaptive_df["actual_cases"]

     >=

     adaptive_df["lower_bound"])

    &

    (adaptive_df["actual_cases"]

     <=

     adaptive_df["upper_bound"])

    )

    .mean()

    *

    100

)


print(

    "Adaptive Conformal Coverage:",

    round(coverage,2),

    "%"

)


# ==================================
# Cell 175:
# Adaptive Prediction Interval Plot
# ==================================

import matplotlib.pyplot as plt


plt.figure(figsize=(14,6))


plt.plot(

    adaptive_df["date"],

    adaptive_df["actual_cases"],

    label="Actual Cases"

)



plt.plot(

    adaptive_df["date"],

    adaptive_df["prediction"],

    label="Prediction"

)



plt.fill_between(

    adaptive_df["date"],

    adaptive_df["lower_bound"],

    adaptive_df["upper_bound"],

    alpha=0.3,

    label="Adaptive 95% Prediction Interval"

)



plt.xlabel("Date")

plt.ylabel("Dengue Cases")


plt.title(

    "Severity-Aware Uncertainty Estimation of DengueFusion-RC-XGB"

)


plt.legend()

plt.xticks(rotation=45)

plt.grid()

plt.tight_layout()

plt.show()


